# Copy this file to .env and fill in real values.
# .env is gitignored — never commit actual secrets.

# Port the Express server listens on. Defaults to 80 if unset
# (matches production behind the ALB). Override locally to avoid
# needing Administrator/root just to bind port 80, e.g. PORT=3000.
PORT=80

# AWS region the DynamoDB "Movies" table lives in.
AWS_REGION=us-east-1

# Secret used to sign the anonymous client-identity cookie. Must be a
# long, random, unguessable string in any real deployment — the app
# will run without this set, but falls back to an insecure shared
# default and prints a warning. Generate one with, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string
